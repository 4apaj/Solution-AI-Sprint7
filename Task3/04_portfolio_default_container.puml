@startuml portfolio_default_container
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title [Container] Инициатива №4 — Прогноз уровня просрочки по портфелю МСБ

Person(risk_mgr, "Риск-менеджер / казначейство", "Планирует резервы и лимиты по портфелю. Потребитель прогноза, не автоответа клиенту")

System_Boundary(core, "Банковский контур (доверенная зона)") {
    ContainerDb(loan_dwh, "Витрина кредитного портфеля", "DWH", "Кредитные истории, отчётность заёмщиков, платёжная дисциплина, макросегменты по ОКВЭД/региону")
    Container(feature_svc, "Сборка признаков портфеля", "код", "Агрегаты по сегментам, винтажи, макропеременные. Уровень сегмента, не лица")
    Container(model_svc, "Модель прогноза просрочки", "gradient boosting / survival", "Оценивает ожидаемый годовой уровень просрочки по сегментам. Обучаемое звено")
    Container(calib, "Калибровка и агрегация", "код", "Калибрует, сворачивает в портфельный прогноз с интервалами. Детерминированное звено")
    Container(scenario, "Сценарные корректировки и правила", "детерминир. код", "Экспертные надбавки, стресс-сценарии, границы правдоподобия прогноза")
    ContainerDb(forecast_store, "Хранилище прогнозов", "СУБД", "Прогноз + интервалы + версия модели + допущения")
    Container(bi, "BI / отчётность", "дашборд", "Прогноз по портфелю и сегментам для риск-комитета")
    Container(monitor, "Мониторинг и backtest", "код", "Дрейф макро/сегментов, ошибка прогноза vs факт, стабильность")
}

System_Ext(macro, "Внешние макроданные", "Ставки, отраслевые индикаторы")

Rel(risk_mgr, bi, "Смотрит прогноз, задаёт сценарии")
Rel(loan_dwh, feature_svc, "Портфель + истории", "batch")
Rel(macro, feature_svc, "Макропеременные")
Rel(feature_svc, model_svc, "Признаки сегментов")
Rel(model_svc, calib, "Сырые оценки")
Rel(calib, scenario, "Калиброванный прогноз")
Rel(risk_mgr, scenario, "Стресс-сценарии, надбавки")
Rel(scenario, forecast_store, "Итоговый прогноз + допущения")
Rel(forecast_store, bi, "Прогноз для отчёта")
Rel(forecast_store, monitor, "Прогноз для backtest")
Rel(loan_dwh, monitor, "Факт просрочки для сверки")
Rel(monitor, risk_mgr, "Алерт: ошибка прогноза / дрейф → пересмотр")

SHOW_LEGEND()
@enduml
