@startuml flagship_container
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title [Container] Инициатива №1 - приоритизация операций для финмониторинга (флагман)

Person(analyst, "Аналитик финмониторинга", "25 сотрудников. Разбирает кейсы из очереди, ~12 мин/операция")
Person(compliance, "Комплаенс / DPO / ПОД-ФТ офицер", "Владелец правил внутреннего контроля, порогов и модели ответственности")

System_Boundary(core, "Банковский контур (доверенная зона)") {
    ContainerDb(ops_store, "Хранилище операций", "СУБД / DWH", "История операций за годы: сумма, назначение (свободный текст), контрагент, ОКВЭД, канал, дата")
    ContainerDb(refs, "Справочники", "СУБД", "Тарифы, лимиты, пороги контроля, чёрные/серые списки")
    Container(rule_engine, "Пороговые правила и внешние сигналы", "Детерминированный код", "Существующая процедура ПОД/ФТ. Помечает ~35 тыс. операций/мес. НЕ отменяется моделью")

    Container(feature_svc, "Сервис признаков (Feature Store)", "Python / offline+online", "Строит признаки: агрегаты по клиенту, паттерны дробления, транзитность, отклонение от профиля ОКВЭД")
    Container(scoring_svc, "Сервис скоринга", "Python, gradient boosting", "Оценивает риск операции. Только РЕКОМЕНДАЦИЯ, решения не принимает")
    Container(calib_gate, "Калибровка, порог и бизнес-правила", "Детерминированный код", "Калибрует score в вероятность, применяет порог, зону воздержания, сверку с сигналом правила, hard-правила ПОД/ФТ")
    ContainerQueue(case_queue, "Очередь кейсов", "Kafka / очередь задач", "Приоритизация по риску x сумма. Кормит существующую очередь финмониторинга")
    Container(case_mgmt, "Система разбора кейсов (case management)", "Web-приложение", "Карточка операции: score, топ-факторы, ссылки на источники, решение аналитика")
    ContainerDb(audit, "Журнал решений", "СУБД (append-only)", "score, версия модели, факторы, решение человека - для аудита надзора и переобучения")
    Container(monitor, "Мониторинг и дрейф", "Prometheus / Evidently", "Вход, дрейф признаков, наполнение очереди, доля воздержаний, бизнес-метрики")
}

System_Ext(kyc, "Платформа «Знай своего клиента» (ЦБ)", "Внешний вспомогательный сигнал уровня риска клиента. Окончательную оценку банк делает сам")
System_Ext(supervisor, "Надзор (ЦБ)", "Получатель обязательной отчётности, источник предписаний")

' Потоки данных
Rel(ops_store, rule_engine, "Операции для порогового контроля", "batch")
Rel(rule_engine, case_queue, "Помеченные операции (~35 тыс/мес)")
Rel(kyc, feature_svc, "Уровень риска клиента", "вспом. сигнал")

Rel(ops_store, feature_svc, "Историю операций", "batch")
Rel(refs, feature_svc, "Пороги, лимиты, списки")
Rel(feature_svc, scoring_svc, "Вектор признаков")
Rel(scoring_svc, calib_gate, "Сырой score + факторы")
Rel(rule_engine, calib_gate, "Сигнал правила (для сверки)")
Rel(calib_gate, case_queue, "Приоритет кейса ИЛИ авто-передача правилу")
Rel(case_queue, case_mgmt, "Кейсы по приоритету")

Rel(analyst, case_mgmt, "Разбирает, выносит решение")
Rel(case_mgmt, audit, "Решение + обоснование")
Rel(case_mgmt, ops_store, "Ссылка на первичные данные", "read")
Rel(compliance, calib_gate, "Задаёт пороги, зону воздержания, hard-правила")

Rel(feature_svc, monitor, "Метрики входа/дрейфа")
Rel(scoring_svc, monitor, "Латентность, доступность, распределение score")
Rel(case_queue, monitor, "Глубина очереди, SLA")
Rel(audit, monitor, "Бизнес-метрики: подтверждения, жалобы")
Rel(monitor, compliance, "Алерты дрейфа/деградации → переобучение или откат")

Rel(case_mgmt, supervisor, "Обязательная фиксация операций", "по процедуре")

SHOW_LEGEND()
@enduml
