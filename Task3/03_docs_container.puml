@startuml docs_container

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title [Container] Инициатива №2 (в связке с №18) - документный конвейер кредитной заявки

Person(underwriter, "Андеррайтер", "Разбирает пакет ~1.5 ч. Получает предзаполненные поля + оригинал для сверки")

System_Boundary(core, "Банковский контур (доверенная зона)") {
    Container(intake, "Приём и карантин документов", "код", "Принимает недоверенный вход клиента: PDF-сканы, Excel, фото. Антивирус, снятие активного содержимого, изоляция")
    ContainerDb(doc_store, "Хранилище документов", "объектное хранилище", "Оригиналы + производные. Банковская тайна / ПДн - доступ по роли")
    Container(classifier, "Классификатор типа документа", "модель (CV)", "Определяет: выписка / отчётность / договор / справка. Обучаемое звено")
    Container(ocr, "OCR / извлечение текста", "модель (OCR)", "Распознаёт текст и структуру таблиц из сканов и фото")
    Container(extractor, "Извлечение полей", "модель + шаблоны", "Тянет поля по типу документа. Обучаемое звено там, где формат разнородный")
    Container(validator, "Валидатор и детерминированные проверки", "код", "Схема полей, контрольные суммы, кросс-сверка (итоги = сумма строк), сверка с реестрами. Confidence-порог")
    ContainerQueue(review_queue, "Очередь верификации", "очередь", "Кейсы с низкой уверенностью или противоречиями -> человеку")
    Container(uw_ui, "Рабочее место андеррайтера", "Web", "Предзаполненные поля рядом с оригиналом. Правка = разметка для дообучения")
    ContainerDb(audit, "Журнал извлечений", "СУБД", "Версия модели, confidence, правки человека")
    Container(monitor, "Мониторинг", "код", "Доля авто-принятых, точность полей, дрейф форматов, глубина очереди")
}

System_Ext(registries, "Внешние реестры", "ЕГРЮЛ/ЕГРИП и пр. - сверка реквизитов контрагентов")

Rel(underwriter, uw_ui, "Загружает пакет, сверяет, подтверждает")
Rel(uw_ui, intake, "Документы")
Rel(intake, doc_store, "Оригиналы (в карантине -> чистые)")
Rel(intake, classifier, "Очищенный документ")
Rel(classifier, ocr, "Тип + документ")
Rel(ocr, extractor, "Текст + структура")
Rel(extractor, validator, "Сырые поля + confidence")
Rel(registries, validator, "Данные для сверки")
Rel(validator, uw_ui, "Валидные поля (высокая уверенность)")
Rel(validator, review_queue, "Низкая уверенность / противоречие", "fallback")
Rel(review_queue, uw_ui, "Кейсы на верификацию")
Rel(uw_ui, audit, "Правки + подтверждение")
Rel(validator, monitor, "Точность, доля авто")
Rel(review_queue, monitor, "Глубина очереди")
Rel(classifier, monitor, "Дрейф форматов документов")

SHOW_LEGEND()
@enduml
